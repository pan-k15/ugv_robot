<?xml version="1.0"?>
<sdf version="1.8">
  <world name="obstacles">

    <!-- ── Physics ───────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Required world systems ────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ── Lighting ───────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ───────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         ARENA PERIMETER WALLS  (10 m × 10 m, centred at origin)
         Wall thickness 0.15 m, height 0.8 m
         ================================================================ -->

    <!-- North wall  (+Y) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.075 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.15 0.15 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.15 0.15 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall  (-Y) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.075 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.15 0.15 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>10.15 0.15 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall  (+X) -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.075 0 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 10.0 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 10.0 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall  (-X) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.075 0 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 10.0 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 10.0 0.8</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         INTERIOR WALLS — create corridors and a room
         ================================================================ -->

    <!-- L-wall segment: horizontal part (NE quadrant) -->
    <model name="inner_wall_h1">
      <static>true</static>
      <pose>1.5 2.0 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.15 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.0 0.15 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- L-wall segment: vertical part (continues south) -->
    <model name="inner_wall_v1">
      <static>true</static>
      <pose>3.0 0.925 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 2.0 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 2.0 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Short divider wall in SW quadrant -->
    <model name="inner_wall_sw">
      <static>true</static>
      <pose>-2.0 -1.5 0.4  0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 0.15 0.8</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.5 0.15 0.8</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         CYLINDER PILLARS  — LiDAR-friendly curved surfaces
         ================================================================ -->

    <model name="pillar_1">
      <static>true</static>
      <pose>-3.0 3.0 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.7 1</ambient><diffuse>0.4 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-3.0 1.0 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.7 1</ambient><diffuse>0.4 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>1.5 -2.5 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.7 1</ambient><diffuse>0.4 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>4.0 -3.5 0.4  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.7 1</ambient><diffuse>0.4 0.4 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         BOX OBSTACLES — various sizes
         ================================================================ -->

    <!-- Large crate (SE quadrant) -->
    <model name="box_large_1">
      <static>true</static>
      <pose>3.5 -1.5 0.3  0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.5 0.6</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 0.5 0.6</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Medium box (NW quadrant) -->
    <model name="box_medium_1">
      <static>true</static>
      <pose>-1.5 3.5 0.25  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Medium box (NW, offset from first) -->
    <model name="box_medium_2">
      <static>true</static>
      <pose>-2.5 4.2 0.25  0 0 0.785</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.4 0.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.5 0.4 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small block cluster (centre-south) -->
    <model name="box_small_1">
      <static>true</static>
      <pose>0.4 -3.0 0.2  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material><ambient>0.7 0.3 0.3 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_small_2">
      <static>true</static>
      <pose>0.9 -3.3 0.2  0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.3 0.3 0.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.4</size></box></geometry>
          <material><ambient>0.7 0.3 0.3 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_small_3">
      <static>true</static>
      <pose>-0.2 -3.5 0.2  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.35 0.25 0.4</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.35 0.25 0.4</size></box></geometry>
          <material><ambient>0.7 0.3 0.3 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tall narrow post (gives LiDAR a thin return) -->
    <model name="post_1">
      <static>true</static>
      <pose>-4.0 -3.0 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 0.1 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="post_2">
      <static>true</static>
      <pose>-4.0 -1.5 0.5  0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 0.1 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 0.1 1.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
