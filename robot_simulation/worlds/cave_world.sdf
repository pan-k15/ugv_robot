<?xml version="1.0"?>
<sdf version="1.8">
  <world name="cave">

    <!-- ── Scene: very low ambient simulates cave darkness ───────────── -->
    <scene>
      <ambient>0.08 0.07 0.06 1</ambient>
      <background>0.02 0.02 0.02 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ── Physics ───────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Required world systems ────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- ── Point lights (warm torch-like glow per chamber) ───────────── -->
    <light type="point" name="light_hub">
      <pose>0 0 1.8 0 0 0</pose>
      <diffuse>0.85 0.70 0.50 1</diffuse>
      <specular>0.10 0.08 0.05 1</specular>
      <attenuation>
        <range>9.0</range>
        <constant>0.30</constant>
        <linear>0.08</linear>
        <quadratic>0.02</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="light_north">
      <pose>0 8 1.8 0 0 0</pose>
      <diffuse>0.80 0.70 0.55 1</diffuse>
      <specular>0.08 0.07 0.05 1</specular>
      <attenuation>
        <range>7.0</range>
        <constant>0.35</constant>
        <linear>0.10</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="light_west">
      <pose>-9 0 1.8 0 0 0</pose>
      <diffuse>0.80 0.70 0.55 1</diffuse>
      <specular>0.08 0.07 0.05 1</specular>
      <attenuation>
        <range>6.0</range>
        <constant>0.35</constant>
        <linear>0.10</linear>
        <quadratic>0.03</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="light_east_corr">
      <pose>5 3.5 1.8 0 0 0</pose>
      <diffuse>0.75 0.65 0.50 1</diffuse>
      <specular>0.07 0.06 0.04 1</specular>
      <attenuation>
        <range>6.0</range>
        <constant>0.40</constant>
        <linear>0.12</linear>
        <quadratic>0.04</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ── Ground ────────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.22 0.20 0.17 1</ambient>
            <diffuse>0.27 0.24 0.20 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         CAVE LAYOUT  (bird's-eye, +Y = north, all walls t=0.2m, h=2.0m)

           Entry tunnel  x[-1, 1]    y[-10,-4]  ← robot spawns at (0,-8)
           Main hub      x[-4, 4]    y[-4,  3]
           North corr    x[-1, 1]    y[ 3,  6]
           North room    x[-4, 4]    y[ 6, 10]
           East corr     x[ 4, 6]    y[ 0,7.5]  ← loop back to north room
           West corr     x[-4,-7]    y[-0.75,0.75]
           West room     x[-7,-11]   y[-2,  2]   ← dead end

         Gaps (passages between spaces):
           Hub S wall   → Entry tunnel  x[-1, 1]
           Hub N wall   → North corr    x[-1, 1]
           Hub W wall   → West corr     y[-0.75, 0.75]
           Hub E wall   → East corr     y[ 0, 1.5]
           N room E wall→ East corr     y[ 6, 7.5]
           W room E wall→ West corr     y[-0.75, 0.75]
         ================================================================ -->

    <!-- ── Entry tunnel ──────────────────────────────────────────────── -->
    <model name="entry_wall_e">
      <static>true</static><pose>1.1 -7.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="entry_wall_w">
      <static>true</static><pose>-1.1 -7.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="entry_cap_s">
      <static>true</static><pose>0.0 -10.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.4 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.4 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Main hub south wall  (gap x∈[-1, 1]) ─────────────────────── -->
    <model name="hub_s_w">
      <static>true</static><pose>-2.5 -4.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="hub_s_e">
      <static>true</static><pose>2.5 -4.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Main hub north wall  (gap x∈[-1, 1]) ─────────────────────── -->
    <model name="hub_n_w">
      <static>true</static><pose>-2.5 3.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="hub_n_e">
      <static>true</static><pose>2.5 3.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Main hub west wall  (gap y∈[-0.75, 0.75]) ────────────────── -->
    <model name="hub_w_s">
      <static>true</static><pose>-4.1 -2.375 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.25 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.25 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="hub_w_n">
      <static>true</static><pose>-4.1 1.875 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 2.25 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.25 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- NW pocket closure: x=-4 from y=3 to y=6 (joins hub W wall to north room W wall) -->
    <model name="cave_nw_ext">
      <static>true</static><pose>-4.1 4.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── Main hub east wall  (gap y∈[0, 1.5] → east corridor) ─────── -->
    <model name="hub_e_s">
      <static>true</static><pose>4.1 -2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="hub_e_n">
      <static>true</static><pose>4.1 2.25 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 1.5 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 1.5 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── North corridor  (x∈[-1, 1], y∈[3, 6]) ────────────────────── -->
    <model name="n_corr_e">
      <static>true</static><pose>1.1 4.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="n_corr_w">
      <static>true</static><pose>-1.1 4.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── North room  (x∈[-4, 4], y∈[6, 10]) ───────────────────────── -->
    <!-- South wall: gap x∈[-1,1] for north corridor -->
    <model name="n_room_s_w">
      <static>true</static><pose>-2.5 5.9 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="n_room_s_e">
      <static>true</static><pose>2.5 5.9 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="n_room_n">
      <static>true</static><pose>0.0 10.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="n_room_w">
      <static>true</static><pose>-4.1 8.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- East wall of north room: gap y∈[6, 7.5] opens into east corridor (loop) -->
    <model name="n_room_e">
      <static>true</static><pose>4.1 8.75 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 2.5 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 2.5 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── East corridor  (x∈[4,6], y∈[0,7.5])  — loop passage ─────── -->
    <!--   Entry: gap in hub east wall y∈[0,1.5]                         -->
    <!--   Exit:  gap in north room east wall y∈[6,7.5]                  -->
    <model name="east_corr_e">
      <static>true</static><pose>6.1 3.75 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 7.5 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 7.5 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- West wall of east corridor between hub N wall and north room S wall (y∈[3,6]) -->
    <model name="east_corr_w">
      <static>true</static><pose>4.1 4.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 3.0 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 3.0 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_corr_s">
      <static>true</static><pose>5.0 -0.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="east_corr_n">
      <static>true</static><pose>5.0 7.6 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.2 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── West corridor  (x∈[-4,-7], y∈[-0.75, 0.75]) ─────────────── -->
    <model name="w_corr_n">
      <static>true</static><pose>-5.5 0.85 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="w_corr_s">
      <static>true</static><pose>-5.5 -0.85 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ── West room  (x∈[-7,-11], y∈[-2, 2])  — dead end ───────────── -->
    <model name="w_room_s">
      <static>true</static><pose>-9.0 -2.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="w_room_n">
      <static>true</static><pose>-9.0 2.1 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.2 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="w_room_w">
      <static>true</static><pose>-11.1 0.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4.4 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4.4 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- East wall of west room: gap y∈[-0.75, 0.75] → west corridor -->
    <model name="w_room_e_s">
      <static>true</static><pose>-7.1 -1.375 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 1.25 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 1.25 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="w_room_e_n">
      <static>true</static><pose>-7.1 1.375 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 1.25 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 1.25 2.0</size></box></geometry>
          <material><ambient>0.28 0.24 0.20 1</ambient><diffuse>0.33 0.28 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================
         ROCK FORMATIONS  — cylinder stalagmites
         Pose z = length/2 so the base sits on the ground.
         ================================================================ -->

    <model name="rock_hub_nw">
      <static>true</static><pose>-2.0 1.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.25</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.20 0.17 0.14 1</ambient><diffuse>0.22 0.18 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock_hub_se">
      <static>true</static><pose>2.5 -2.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.30</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.30</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.20 0.17 0.14 1</ambient><diffuse>0.22 0.18 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock_hub_c">
      <static>true</static><pose>-1.0 -1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.20</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.20 0.17 0.14 1</ambient><diffuse>0.22 0.18 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <model name="rock_hub_ne">
      <static>true</static><pose>2.2 2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.18</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.20 0.17 0.14 1</ambient><diffuse>0.22 0.18 0.15 1</diffuse></material></visual>
